# Copy to .env.local for local development. Both values are safe to expose in a
# browser bundle: the publishable key only grants what Row Level Security allows.
#
# Find them at:
#   https://supabase.com/dashboard/project/_/settings/api

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
