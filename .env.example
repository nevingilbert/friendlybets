# ---------------------------------------------------------------------------
# FriendlyBets — environment variables
# Copy to .env.local for local development (or `vercel env pull .env.local`);
# set the same keys in Vercel.
#
# Every value here is SERVER-ONLY. The browser never talks to the database and
# never sees an OAuth secret.
# ---------------------------------------------------------------------------

# --- Database (Neon) -------------------------------------------------------
# Pooled connection string — the one with "-pooler" in the host.
DATABASE_URL=

# Direct (unpooled) connection, used by `npm run db:migrate` and the Supabase
# import. Falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=

# --- Google sign-in (Auth.js) ----------------------------------------------
# Signing secret for the session cookie: `openssl rand -base64 33`
AUTH_SECRET=

# Google OAuth client. Authorized redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://bets.gilbyy.com/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Production only: pins the OAuth callback to one host. Leave unset locally.
# AUTH_URL=https://bets.gilbyy.com
